# Copier ce fichier en deploy.env (ignoré par git, jamais commité) et
# adapter les valeurs avant de lancer updateBack.sh / updateFront.sh /
# lancerTestApi.sh. Ces identifiants ne doivent jamais être commités en clair.

# Hôte, identifiants et base MySQL utilisés par le backend
MYSQL_HOST=127.0.0.1
MYSQL_USER=changeme
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=intranet

# Hôte/port du backend tel que le conteneur frontend peut l'atteindre.
# BACKEND_PORT est aussi le port hôte exposé par le conteneur backend lui-même
# (updateBack.sh) : une seule variable pour les deux usages.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=7780

# Port hôte exposé par le conteneur frontend (updateFront.sh)
FRONTEND_PORT=8081

# Nom affiché dans l'application (sidebar, page de connexion, titre Swagger).
# Passé aux deux conteneurs (backend et frontend) par les scripts de déploiement.
APP_NAME=GarageDesk

# Envoi des rappels de RDV par l'ordonnanceur du backend.
#   1 = cette instance envoie les rappels (production)
#   0 = elle ne les envoie pas (instance de secours)
#
# OBLIGATOIRE sur l'instance de production : absente, la valeur vaut 0 et aucun
# rappel ne part. Ce défaut prudent est voulu — une seconde instance alimentée par
# les sauvegardes tourne sur une copie de la production et enverrait les mêmes
# rappels une seconde fois aux clients. Mieux vaut suspendre des rappels, ce qui se
# répare, que d'en envoyer en double, ce qui ne se rattrape pas. L'oubli se voit
# d'ailleurs aussitôt : le coin haut gauche de l'interface passe au rouge.
SCHEDULER_ENABLED=1
