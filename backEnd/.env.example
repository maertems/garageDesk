# Copier ce fichier en .env (ignoré par git) et adapter les valeurs.
# Utilisé aussi bien en local (uvicorn) qu'en Docker (docker run -e ... ou --env-file).

# Nom affiché de l'application (titre Swagger /docs, etc.) — pour un déploiement en marque blanche.
APP_NAME=GarageDesk

# Base de données MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=intranet

# Fuseau horaire pour l'affichage des heures dans les notifications (SMS/email).
# Les rendez-vous sont stockés en UTC en base.
DISPLAY_TIMEZONE=Europe/Paris

# Répertoire des fichiers de log (actions.log, notifications.log)
LOGS_DIR=/app/logs
