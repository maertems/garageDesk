# Copier ce fichier en .env (ignoré par git) et adapter les valeurs.
# Next.js charge automatiquement .env / .env.local au démarrage (npm run dev / npm start).

# URL de l'API backend telle que le serveur Next.js peut l'atteindre.
# Jamais exposée au navigateur : tous les appels API passent par le serveur
# (proxy /api/proxy/...), jamais directement depuis le client.
BACKEND_URL=http://localhost:7780

# Nom affiché de l'application (sidebar, page de connexion, titre d'onglet)
# — pour un déploiement en marque blanche, sans reconstruire l'image Docker.
APP_NAME=GarageDesk
