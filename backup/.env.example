# Identifiants MySQL des scripts de sauvegarde et de restauration.
#
# Copier ce fichier en `.env` dans ce même répertoire et le renseigner :
#     cp backup/.env.example backup/.env
#
# Il est volontairement distinct du deploy.env de la racine : ces deux scripts
# peuvent ainsi tourner sur une machine qui n'héberge pas l'application, sans y
# recopier toute sa configuration de déploiement.
#
# `.env` est ignoré par git dans n'importe quel répertoire : il ne partira jamais
# dans le dépôt, qui est public. Ne jamais renseigner ce fichier-ci, qui l'est.
#
# Un compte dédié à la sauvegarde est un bon usage. Il lui faut au minimum SELECT,
# plus TRIGGER et EVENT (mysqldump est appelé avec --routines --triggers --events),
# et pour la restauration les droits d'écriture et de structure sur la base.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=changeme
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=intranet
